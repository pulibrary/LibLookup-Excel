{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackagePrefixes": ["@babel/"],
      "groupName": "babel monorepo"
    },
    {
      "matchPackageNames": ["typescript", "typescript-eslint","/^eslint/","/^@typescript-eslint//"],
      "matchPackagePrefixes": ["@eslint/","@typescript-eslint/", "@types/"],
      "groupName": "typescript and eslint"
    }
  ]
}
